.article-sort
  margin: 0
  padding: 0
  border: none

  &-title
    margin: 0 0 24px
    padding: 0 0 14px
    border-bottom: 1px solid rgba(128, 128, 128, .18)
    color: var(--font-color)
    font-size: 1.48em
    font-weight: 600
    letter-spacing: -.01em
    line-height: 1.35

  &-item
    position: relative
    display: flex
    align-items: center
    gap: 14px
    margin: 2px -12px
    padding: 11px 12px
    border-radius: 10px
    transition: background-color .18s ease

    &:not(.year):hover
      background: rgba(128, 128, 128, .08)

      .article-sort-item-title
        color: $text-hover

      .article-sort-item-time
        opacity: .82

    &.no-article-cover
      height: auto

      .article-sort-item-info
        padding: 0

    &.year
      margin: 28px 0 8px
      padding: 0 0 8px
      border-bottom: 1px solid rgba(128, 128, 128, .12)
      border-radius: 0
      color: var(--font-color)
      opacity: .56
      font-size: 1.06em
      font-weight: 600
      font-variant-numeric: tabular-nums
      letter-spacing: .04em
      line-height: 1.4

      &:first-child
        margin-top: 0

    &-info
      flex: 1
      min-width: 0
      display: flex
      align-items: baseline
      justify-content: space-between
      gap: 20px

      +maxWidth768()
        flex-direction: column
        align-items: flex-start
        gap: 3px

    &-title
      flex: 1
      min-width: 0
      @extend .limit-more-line
      color: var(--font-color)
      font-size: 1.02em
      font-weight: 500
      line-height: 1.5
      transition: color .18s ease
      -webkit-line-clamp: 2

      &:after
        position: absolute
        inset: 0
        content: ''

    &-time
      flex-shrink: 0
      color: var(--font-color)
      opacity: .5
      font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
      font-size: .82em
      font-variant-numeric: tabular-nums
      letter-spacing: -.01em
      white-space: nowrap
      transition: opacity .18s ease

      time
        padding-left: 0
        cursor: pointer

    &-img
      position: relative
      z-index: 1
      flex-shrink: 0
      overflow: hidden
      width: 72px
      height: 48px
      border-radius: 8px

      +maxWidth768()
        width: 64px
        height: 46px

      :first-child
        @extend .imgHover

[data-theme='dark']
  .article-sort
    &-title
      border-bottom-color: rgba(255, 255, 255, .12)

    &-item
      &:not(.year):hover
        background: rgba(255, 255, 255, .07)

      &.year
        border-bottom-color: rgba(255, 255, 255, .09)
