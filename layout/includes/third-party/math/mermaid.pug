script.
  (() => {
    const styles = !{JSON.stringify({ themes: theme.mermaid.theme, variables: theme.mermaid.theme_variables, options: theme.mermaid.options })}
    let library
    let renderPass = 0
    let renderQueue = Promise.resolve()

    const runMermaid = async (diagrams, pass) => {
      if (pass !== renderPass || !diagrams[0].isConnected) return
      if (!window.mermaid) {
        try {
          await (library ||= btf.getScript('!{url_for(theme.asset.mermaid)}'))
        } catch (error) {
          library = undefined
          console.error('Could not load Mermaid', error)
          return
        }
      }

      if (pass !== renderPass || !diagrams[0].isConnected) return
      const mode = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
      mermaid.initialize({
        ...styles.options,
        startOnLoad: false,
        theme: styles.themes[mode],
        themeVariables: styles.variables?.[mode]
      })
      for (const [index, diagram] of diagrams.entries()) {
        if (pass !== renderPass || !diagram.isConnected) return
        const source = diagram.firstElementChild
        try {
          const result = await mermaid.render(`mermaid-${pass}-${index}`, source.textContent)
          if (pass !== renderPass || !diagram.isConnected) return
          diagram.querySelector(':scope > svg')?.remove()
          diagram.insertAdjacentHTML('beforeend', typeof result === 'string' ? result : result.svg)
          result.bindFunctions?.(diagram)
          source.hidden = true
        } catch (error) {
          console.error('Could not render Mermaid diagram', error)
        }
      }
    }

    const codeToMermaid = () => {
      const blocks = document.querySelectorAll('#article-container pre > code.mermaid, #article-container pre > code.language-mermaid')
      blocks.forEach(code => {
        const source = code.parentElement
        const diagram = document.createElement('div')
        diagram.className = 'mermaid-wrap'
        source.classList.add('mermaid-src')
        source.replaceWith(diagram)
        diagram.append(source)
      })
    }

    const loadMermaid = () => {
      if (!{theme.mermaid.code_write}) codeToMermaid()
      const diagrams = document.querySelectorAll('#article-container .mermaid-wrap')
      if (!diagrams.length) return

      const render = () => {
        const pass = ++renderPass
        renderQueue = renderQueue.then(() => runMermaid(diagrams, pass)).catch(error => {
          console.error('Could not render Mermaid diagrams', error)
        })
      }
      btf.addGlobalFn('themeChange', render, 'mermaid')
      render()
    }

    btf.addGlobalFn('encrypt', loadMermaid, 'mermaid')
    window.pjax ? loadMermaid() : document.addEventListener('DOMContentLoaded', loadMermaid)
  })()